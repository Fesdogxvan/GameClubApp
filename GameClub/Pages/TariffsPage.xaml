<Page x:Class="GameClub.Pages.TariffsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TariffsPage"
      Background="#1E1E2E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Тарифы"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Панель управления -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Добавить"
                        Click="BtnAdd_Click"
                        Style="{StaticResource ActionButton}"/>
                <Button Content="Изменить"
                        Click="BtnEdit_Click"
                        Style="{StaticResource ActionButton}"/>
                <Button Content="Удалить"
                        Click="BtnDelete_Click"
                        Style="{StaticResource ActionButton}"/>
                <Button Content="Обновить"
                        Click="BtnRefresh_Click"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Поиск:"
                           Foreground="#E0E0E0"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBox x:Name="TbSearch"
                         Width="250"
                         Margin="0"
                         TextChanged="TbSearch_TextChanged"/>
            </StackPanel>
        </Grid>

        <!-- Таблица тарифов -->
        <DataGrid Grid.Row="2"
                  x:Name="DgTariffs"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="#2A2A3E"
                  Foreground="White"
                  RowBackground="#2A2A3E"
                  AlternatingRowBackground="#252535"
                  BorderBrush="#3A3A4E"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3A3A4E"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  MouseDoubleClick="DgTariffs_MouseDoubleClick">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#252535"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#3A3A4E"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#7B68EE"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"            Binding="{Binding TariffID}"        Width="60"/>
                <DataGridTextColumn Header="Название"      Binding="{Binding Name}"            Width="200"/>
                <DataGridTextColumn Header="Цена за час"   Binding="{Binding PricePerHour, StringFormat={}{0:N2} ₽}" Width="150"/>
                <DataGridTextColumn Header="Описание"      Binding="{Binding Description}"     Width="*"/>
                <DataGridCheckBoxColumn Header="Активен"   Binding="{Binding IsActive}"        Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>