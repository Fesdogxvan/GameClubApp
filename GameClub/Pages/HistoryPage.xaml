<Page x:Class="GameClub.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HistoryPage"
      Background="#1E1E2E">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="История посещений"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1"
                Background="#2A2A3E"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Клиент" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CbFilterCustomer"
                              DisplayMemberPath="FullName"
                              SelectionChanged="FilterCombo_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Рабочее место" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CbFilterWorkstation"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="FilterCombo_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Статус" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CbFilterStatus"
                              SelectionChanged="FilterCombo_Changed">
                        <ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="Активна"/>
                        <ComboBoxItem Content="Завершена"/>
                        <ComboBoxItem Content="Отменена"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="С даты" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,3"/>
                    <DatePicker x:Name="DpFrom"
                                Width="130"
                                SelectedDateChanged="FilterDate_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="По дату" Foreground="#E0E0E0" FontSize="12" Margin="0,0,0,3"/>
                    <DatePicker x:Name="DpTo"
                                Width="130"
                                SelectedDateChanged="FilterDate_Changed"/>
                </StackPanel>

                <Button Grid.Column="5"
                        Content="Сбросить"
                        Click="BtnReset_Click"
                        Style="{StaticResource ActionButton}"
                        Height="38"
                        Margin="0,18,0,0"
                        Width="110"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  x:Name="DgHistory"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="#2A2A3E"
                  Foreground="White"
                  RowBackground="#2A2A3E"
                  AlternatingRowBackground="#252535"
                  BorderBrush="#3A3A4E"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3A3A4E"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#252535"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderBrush" Value="#3A3A4E"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#7B68EE"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding SessionID}" Width="50"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Customer.FullName}" Width="*"/>
                <DataGridTextColumn Header="ПК" Binding="{Binding Workstation.Name}" Width="130"/>
                <DataGridTextColumn Header="Тариф" Binding="{Binding Tariff.Name}" Width="100"/>
                <DataGridTextColumn Header="Игра" Binding="{Binding Game.Name}" Width="160"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Конец" Binding="{Binding EndTime, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Минут" Binding="{Binding MinutesPlayed}" Width="70"/>
                <DataGridTextColumn Header="Стоимость, руб." Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Background="#2A2A3E"
                CornerRadius="8"
                Padding="15"
                Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TbStatCount"
                           Foreground="#E0E0E0" FontSize="13" Margin="0,0,25,0"/>
                <TextBlock x:Name="TbStatRevenue"
                           Foreground="#4CAF50" FontSize="13" FontWeight="Bold" Margin="0,0,25,0"/>
                <TextBlock x:Name="TbStatAvg"
                           Foreground="#E0E0E0" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>