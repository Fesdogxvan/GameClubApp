<Window x:Class="GameClub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Игровой клуб" 
        ResizeMode="CanMinimize" 
        Height="750" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252535">
            <StackPanel>
                <TextBlock Text="ИГРОВОЙ КЛУБ"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,10"/>

                <Border Background="#1E1E2E"
                        CornerRadius="5"
                        Margin="10,0,10,15"
                        Padding="10,8">
                    <StackPanel>
                        <TextBlock x:Name="TbUserName"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TbUserRole"
                                   Foreground="#A0A0B0"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnMain" Content="Главная" Style="{StaticResource MenuButton}" Click="BtnMain_Click"/>
                <Button x:Name="BtnSessions" Content="Сессии" Style="{StaticResource MenuButton}" Click="BtnSessions_Click"/>
                <Button x:Name="BtnHistory" Content="История" Style="{StaticResource MenuButton}" Click="BtnHistory_Click"/>
                <Button x:Name="BtnCustomers" Content="Клиенты" Style="{StaticResource MenuButton}" Click="BtnCustomers_Click"/>
                <Button x:Name="BtnTariffs" Content="Тарифы" Style="{StaticResource MenuButton}" Click="BtnTariffs_Click"/>
                <Button x:Name="BtnGames" Content="Игры" Style="{StaticResource MenuButton}" Click="BtnGames_Click"/>
                <Button x:Name="BtnComponents" Content="Комплектующие" Style="{StaticResource MenuButton}" Click="BtnComponents_Click"/>

                <Separator Background="#3A3A4E" Margin="10,15,10,10"/>

                <Button x:Name="BtnLogout" Content="Выход" Style="{StaticResource MenuButton}" Click="BtnLogout_Click"/>
            </StackPanel>
        </Border>

        <Frame Grid.Column="1"
               NavigationUIVisibility="Hidden"
               x:Name="MainFrame"/>
    </Grid>
</Window>