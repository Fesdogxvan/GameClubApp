<Window x:Class="GameClub.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Игровой клуб. Авторизация"
        Height="500" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1E1E2E">
    <Grid>
        <Border Background="#2A2A3E"
                CornerRadius="10"
                Width="380"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="ИГРОВОЙ КЛУБ"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Авторизация"
                           Foreground="#A0A0B0"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <TextBlock Text="Логин" Foreground="#E0E0E0" Margin="0,0,0,5"/>
                <TextBox x:Name="TbLogin" Background="#1E1E2E" Foreground="White" BorderBrush="#7B68EE"/>

                <TextBlock Text="Пароль" Foreground="#E0E0E0" Margin="0,5,0,5"/>
                <PasswordBox x:Name="PbPassword" Background="#1E1E2E" Foreground="White" BorderBrush="#7B68EE"/>

                <Button x:Name="BtnLogin"
                        Content="Войти"
                        Click="BtnLogin_Click"
                        Background="#7B68EE"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        Height="40"
                        Margin="0,20,0,0"
                        Cursor="Hand"/>

                <TextBlock x:Name="TbError"
                           Foreground="#E53935"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>